\begin{tikzpicture}[xscale=2,yscale=.8]
\draw[arr] (.6,0)--(3.5,0) node[right] {$V/(Sh)$};
\draw[arr] (.7,0)--(.7,5) node[above] {$p/(\rho gh)$};
\draw[very thick,blue,arr] (1,4)--(2,4);
