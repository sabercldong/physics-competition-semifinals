\begin{tikzpicture}[xscale=1.6,yscale=3]
\draw[arr] (0,0)--(4.4,0) node[right] {$t/(v_{\max}/a_{\max})$};
\draw[arr] (0,0)--(0,1.25) node[above] {$v/v_{\max}$};
